{
  "name": "character-quest",
  "version": "1.0.0",
  "private": true,
  "description": "Educational multiplayer voxel world: learn, earn, build.",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace client",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "start": "npm run start --workspace server",
    "migrate": "node server/dist/cli.js migrate",
    "seed": "node server/dist/cli.js seed",
    "test": "npm run test --workspace server",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "backup": "node server/dist/cli.js backup",
    "restore": "node server/dist/cli.js restore",
    "build:offline": "node offline/build.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
