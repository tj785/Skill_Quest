{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": { "@cq/shared": ["./../shared/src/index.ts"] },
    "allowImportingTsExtensions": false
  },
  "include": ["src", "test", "../shared/src"]
}
